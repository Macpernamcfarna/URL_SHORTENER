<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>URL Shortener</title>
</head>
<body class="bg-dark text-success" style="background: #020b08; color: #8effc1;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card border-success border-2 shadow-lg" style="background: rgba(8, 19, 13, 0.95); box-shadow: 0 0 25px rgba(16, 185, 129, 0.35);">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="mb-4 text-center fw-bold text-success" style="letter-spacing: 0.08em; text-shadow: 0 0 1px rgba(63, 255, 185, 0.9);">URL SHORTENER</h1>

                        <form action="/shortUrl" method="POST" class="row g-3 align-items-end">
                            <div class="col-md-9">
                                <label for="fullUrl" class="form-label fw-semibold text-success">Enter URL to shorten</label>
                                <input type="url" name="fullUrl" class="form-control bg-dark text-success border-success border-2" style="box-shadow: inset 0 0 10px rgba(16,185,129,.15);" placeholder="https://example.com/very-long-url" required id="fullUrl">
                            </div>
                            <div class="col-md-3 d-grid">
                                <button type="submit" class="btn btn-success btn-lg fw-bold px-4" style="box-shadow: 0 0 18px rgba(16, 185, 129, 0.5);">Shorten</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card mt-4 border-success border-2" style="background: rgba(8, 19, 13, 0.95); box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-striped table-hover mb-0 align-middle">
                                <thead class="table-success" style="--bs-table-bg: rgba(16, 185, 129, 0.12); color: #a7f3d0;">
                                    <tr style="text-shadow: 0 0 10px rgba(154, 255, 218, 0.9);">
                                        <th>Short URL</th>
                                        <th>Full URL</th>
                                        <th>Clicks</th>
                                    </tr>
                                </thead>
                                <tbody id="urlTableBody">
                                    <% shortUrls.forEach(shortUrl => { %>
                                        <tr>
                                            <td><a href="/<%= shortUrl.short %>" target="_blank" class="text-success text-decoration-none fw-semibold">/<%= shortUrl.short %></a></td>
                                            <td><a href="<%= shortUrl.full %>" target="_blank" class="text-success text-decoration-none"><%= shortUrl.full %></a></td>
                                            <td><span class="badge rounded-pill text-bg-success text-dark"><%= shortUrl.clicks %></span></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>